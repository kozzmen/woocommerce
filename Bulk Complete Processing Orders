<?php
/**
 * Plugin Name: Bulk Complete Processing Orders
 * Description: Adds a Tools page to bulk mark all WooCommerce "Processing" orders as "Completed" using AJAX batch processing.
 * Version: 2.0
 * Author: Stefan Velev
 */

if ( ! defined( 'ABSPATH' ) ) {
    exit;
}

class Bulk_Complete_Processing_Orders {

    /**
     * Default batch size
     */
    const DEFAULT_BATCH_SIZE = 25;

    public function __construct() {
        add_action( 'admin_menu', array( $this, 'add_tools_page' ) );
        add_action( 'admin_enqueue_scripts', array( $this, 'enqueue_scripts' ) );
        add_action( 'wp_ajax_bulk_complete_batch', array( $this, 'ajax_process_batch' ) );
    }

    /**
     * Add submenu page under Tools
     */
    public function add_tools_page() {
        add_management_page(
            'Bulk Complete Orders',
            'Bulk Complete Orders',
            'manage_woocommerce',
            'bulk-complete-orders',
            array( $this, 'render_settings_page' )
        );
    }

    /**
     * Enqueue scripts only on our tools page
     */
    public function enqueue_scripts( $hook ) {
        if ( $hook !== 'tools_page_bulk-complete-orders' ) {
            return;
        }

        wp_enqueue_script(
            'bulk-complete-orders-js',
            '', // We'll use inline script
            array( 'jquery' ),
            '2.0',
            true
        );

        // Pass AJAX data to the page via inline script
        wp_localize_script( 'jquery', 'bulkCompleteOrders', array(
            'ajax_url' => admin_url( 'admin-ajax.php' ),
            'nonce'    => wp_create_nonce( 'bulk_complete_orders_nonce' ),
        ) );
    }

    /**
     * Get count of processing orders
     */
    private function get_processing_count() {
        $orders = wc_get_orders( array(
            'status' => 'processing',
            'limit'  => -1,
            'return' => 'ids',
        ) );
        return count( $orders );
    }

    /**
     * Render the settings/tools page
     */
    public function render_settings_page() {
        $count = $this->get_processing_count();
        ?>
        <div class="wrap">
            <h1>Bulk Complete Processing Orders</h1>

            <div class="card" style="max-width: 650px; padding: 20px;">
                <h2>Mark All Processing Orders as Completed</h2>
                <p>
                    This tool will change the status of <strong>all</strong> orders currently
                    set to <em>"Processing"</em> to <em>"Completed"</em>.
                    Orders are processed in <strong>batches</strong> to prevent server timeouts.
                </p>

                <table class="form-table" style="margin: 0;">
                    <tr>
                        <th scope="row">Processing Orders</th>
                        <td>
                            <span id="bco-total-count" style="font-size: 1.4em; font-weight: bold; color: #0073aa;">
                                <?php echo esc_html( $count ); ?>
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <th scope="row"><label for="bco-batch-size">Batch Size</label></th>
                        <td>
                            <select id="bco-batch-size">
                                <option value="10">10 orders per batch</option>
                                <option value="25" selected>25 orders per batch (recommended)</option>
                                <option value="50">50 orders per batch</option>
                                <option value="75">75 orders per batch</option>
                                <option value="100">100 orders per batch</option>
                            </select>
                            <p class="description">
                                Lower batch sizes are safer for shared hosting. Increase if your server can handle it.
                            </p>
                        </td>
                    </tr>
                    <tr>
                        <th scope="row">Suppress Emails</th>
                        <td>
                            <label>
                                <input type="checkbox" id="bco-suppress-emails" value="1" checked />
                                Prevent WooCommerce from sending "Order Completed" emails during bulk update
                            </label>
                        </td>
                    </tr>
                </table>

                <?php if ( $count > 0 ) : ?>
                    <div style="margin-top: 15px;">
                        <label>
                            <input type="checkbox" id="bco-confirm" value="1" />
                            I confirm I want to mark all <strong><?php echo esc_html( $count ); ?></strong>
                            processing order(s) as completed.
                        </label>
                    </div>

                    <p style="margin-top: 15px;">
                        <button type="button" id="bco-start-btn" class="button button-primary" disabled>
                            🚀 Start Batch Processing
                        </button>
                        <button type="button" id="bco-stop-btn" class="button button-secondary" style="display:none;">
                            ⏹ Stop
                        </button>
                    </p>
                <?php else : ?>
                    <p style="color: green; margin-top: 15px;">
                        <strong>✅ No orders in "Processing" status. Nothing to do!</strong>
                    </p>
                <?php endif; ?>

                <!-- Progress Section -->
                <div id="bco-progress-section" style="display: none; margin-top: 20px;">
                    <h3>Progress</h3>
                    <div style="background: #e0e0e0; border-radius: 4px; overflow: hidden; height: 30px; position: relative;">
                        <div id="bco-progress-bar" style="background: #0073aa; height: 100%; width: 0%; transition: width 0.3s ease; border-radius: 4px;"></div>
                        <span id="bco-progress-text" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-weight: bold; color: #333;">
                            0%
                        </span>
                    </div>
                    <p id="bco-progress-details" style="margin-top: 8px; color: #555;">
                        Waiting to start...
                    </p>
                </div>

                <!-- Log Section -->
                <div id="bco-log-section" style="display: none; margin-top: 15px;">
                    <h3>Log</h3>
                    <div id="bco-log" style="background: #1d2327; color: #00ff41; padding: 12px; border-radius: 4px; max-height: 200px; overflow-y: auto; font-family: monospace; font-size: 12px;">
                    </div>
                </div>

                <!-- Completion Section -->
                <div id="bco-complete-section" style="display: none; margin-top: 15px;">
                    <div class="notice notice-success inline" style="margin: 0;">
                        <p id="bco-complete-message"></p>
                    </div>
                </div>
            </div>
        </div>

        <script type="text/javascript">
        jQuery(document).ready(function($) {

            var isRunning = false;
            var totalProcessed = 0;
            var totalOrders = parseInt( $('#bco-total-count').text(), 10 );
            var stopRequested = false;

            // Enable/disable start button based on confirmation checkbox
            $('#bco-confirm').on('change', function() {
                $('#bco-start-btn').prop('disabled', !$(this).is(':checked'));
            });

            // Start processing
            $('#bco-start-btn').on('click', function() {
                if ( isRunning ) return;
                if ( !confirm('Are you sure you want to mark all processing orders as completed?') ) return;

                isRunning = true;
                stopRequested = false;
                totalProcessed = 0;

                $('#bco-start-btn').prop('disabled', true).text('⏳ Processing...');
                $('#bco-stop-btn').show();
                $('#bco-confirm').prop('disabled', true);
                $('#bco-batch-size').prop('disabled', true);
                $('#bco-suppress-emails').prop('disabled', true);
                $('#bco-progress-section').slideDown();
                $('#bco-log-section').slideDown();
                $('#bco-complete-section').hide();
                $('#bco-log').empty();

                addLog('🟢 Batch processing started...');
                processBatch();
            });

            // Stop processing
            $('#bco-stop-btn').on('click', function() {
                stopRequested = true;
                addLog('🟡 Stop requested. Finishing current batch...');
                $(this).prop('disabled', true).text('⏳ Stopping...');
            });

            function processBatch() {
                if ( stopRequested ) {
                    finishProcessing('stopped');
                    return;
                }

                var batchSize = parseInt( $('#bco-batch-size').val(), 10 );
                var suppressEmails = $('#bco-suppress-emails').is(':checked') ? 1 : 0;

                $.ajax({
                    url: bulkCompleteOrders.ajax_url,
                    type: 'POST',
                    data: {
                        action: 'bulk_complete_batch',
                        nonce: bulkCompleteOrders.nonce,
                        batch_size: batchSize,
                        suppress_emails: suppressEmails
                    },
                    success: function(response) {
                        if ( response.success ) {
                            var data = response.data;
                            totalProcessed += data.processed;

                            // Update progress
                            var percent = totalOrders > 0 ? Math.min( Math.round( (totalProcessed / totalOrders) * 100 ), 100 ) : 100;
                            $('#bco-progress-bar').css('width', percent + '%');
                            $('#bco-progress-text').text( percent + '%' );
                            $('#bco-progress-details').text(
                                'Processed ' + totalProcessed + ' of ' + totalOrders + ' orders | Remaining: ' + data.remaining
                            );

                            addLog('✅ Batch done: ' + data.processed + ' orders completed. Remaining: ' + data.remaining);

                            if ( data.remaining > 0 && !stopRequested ) {
                                // Small delay to let the server breathe
                                setTimeout( processBatch, 1000 );
                            } else {
                                finishProcessing('complete');
                            }
                        } else {
                            addLog('❌ Error: ' + (response.data || 'Unknown error'));
                            finishProcessing('error');
                        }
                    },
                    error: function(xhr, status, error) {
                        addLog('❌ AJAX Error: ' + error + ' (Status: ' + xhr.status + ')');
                        addLog('💡 Try reducing the batch size and click Start again.');
                        finishProcessing('error');
                    }
                });
            }

            function finishProcessing( status ) {
                isRunning = false;
                $('#bco-stop-btn').hide().prop('disabled', false).text('⏹ Stop');
                $('#bco-confirm').prop('disabled', false);
                $('#bco-batch-size').prop('disabled', false);
                $('#bco-suppress-emails').prop('disabled', false);

                if ( status === 'complete' ) {
                    $('#bco-progress-bar').css('width', '100%').css('background', '#00a32a');
                    $('#bco-progress-text').text('100%');
                    $('#bco-start-btn').text('✅ Done!').prop('disabled', true);
                    $('#bco-complete-section').show();
                    $('#bco-complete-message').html(
                        '🎉 <strong>' + totalProcessed + '</strong> order(s) have been marked as "Completed" successfully!'
                    );
                    addLog('🏁 All done! ' + totalProcessed + ' orders completed.');
                    // Update counter
                    $('#bco-total-count').text('0');
                } else if ( status === 'stopped' ) {
                    $('#bco-progress-bar').css('background', '#dba617');
                    $('#bco-start-btn').text('🚀 Resume Processing').prop('disabled', false);
                    addLog('⏹ Stopped. ' + totalProcessed + ' orders were completed before stopping.');
                    // Update counter
                    var newRemaining = totalOrders - totalProcessed;
                    $('#bco-total-count').text( newRemaining > 0 ? newRemaining : 0 );
                    totalOrders = newRemaining > 0 ? newRemaining : 0;
                } else {
                    $('#bco-progress-bar').css('background', '#d63638');
                    $('#bco-start-btn').text('🔄 Retry').prop('disabled', false);
                    addLog('⚠️ Processing stopped due to an error. You can retry with a smaller batch size.');
                }
            }

            function addLog( message ) {
                var time = new Date().toLocaleTimeString();
                $('#bco-log').append('[' + time + '] ' + message + '\n');
                $('#bco-log').scrollTop( $('#bco-log')[0].scrollHeight );
            }
        });
        </script>
        <?php
    }

    /**
     * AJAX handler: Process a single batch of orders
     */
    public function ajax_process_batch() {
        // Verify nonce
        if ( ! check_ajax_referer( 'bulk_complete_orders_nonce', 'nonce', false ) ) {
            wp_send_json_error( 'Security check failed.' );
        }

        // Check capability
        if ( ! current_user_can( 'manage_woocommerce' ) ) {
            wp_send_json_error( 'Unauthorized.' );
        }

        $batch_size      = isset( $_POST['batch_size'] ) ? absint( $_POST['batch_size'] ) : self::DEFAULT_BATCH_SIZE;
        $suppress_emails = isset( $_POST['suppress_emails'] ) && $_POST['suppress_emails'] == '1';

        // Clamp batch size between 5 and 100
        $batch_size = max( 5, min( 100, $batch_size ) );

        // Suppress WooCommerce completed order emails if requested
        if ( $suppress_emails ) {
            add_filter( 'woocommerce_email_enabled_customer_completed_order', '__return_false' );
            add_filter( 'woocommerce_email_enabled_customer_completed_renewal_order', '__return_false' );
        }

        // Fetch only a limited batch of processing orders
        $processing_orders = wc_get_orders( array(
            'status' => 'processing',
            'limit'  => $batch_size,
            'orderby' => 'date',
            'order'   => 'ASC',
        ) );

        $processed = 0;

        foreach ( $processing_orders as $order ) {
            $order->update_status( 'completed', 'Bulk status update via Bulk Complete Orders tool.' );
            $processed++;
        }

        // Get remaining count
        $remaining_orders = wc_get_orders( array(
            'status' => 'processing',
            'limit'  => -1,
            'return' => 'ids',
        ) );
        $remaining = count( $remaining_orders );

        wp_send_json_success( array(
            'processed' => $processed,
            'remaining' => $remaining,
        ) );
    }
}

// Initialize only if WooCommerce is active
add_action( 'plugins_loaded', function() {
    if ( class_exists( 'WooCommerce' ) ) {
        new Bulk_Complete_Processing_Orders();
    }
} );
