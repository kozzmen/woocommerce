    /* ───────────────────────────────
     *  ENQUEUE JS (inline for simplicity)
     * ─────────────────────────────── */
    public function enqueue_scripts( $hook ) {
        if ( $hook !== 'tools_page_bulk-complete-orders' ) {
            return;
        }
        wp_enqueue_script( 'jquery' );
        wp_add_inline_script( 'jquery', $this->get_inline_js() );
        wp_localize_script( 'jquery', 'bco', [
            'ajax_url' => admin_url( 'admin-ajax.php' ),
            'nonce'    => wp_create_nonce( 'bco_nonce' ),
        ] );
    }

    private function get_inline_js() {
        ob_start(); ?>
        (function($){
            /* ── Bulk Complete ── */
            let running = false, stopped = false, processed = 0, total = 0;

            $('#bco-start').on('click', function(){
                if(running) return;
                running = true; stopped = false; processed = 0;
                $(this).hide(); $('#bco-stop').show();
                $('#bco-progress,#bco-log').show();
                $('#bco-log').html('');
                log('Counting processing orders…');

                $.post(bco.ajax_url,{action:'bco_count_orders',nonce:bco.nonce},function(r){
                    if(!r.success){log('Error: '+r.data);finish();return;}
                    total = r.data.count;
                    log('Found '+total+' processing orders.');
                    if(total===0){finish();return;}
                    nextBatch();
                });
            });

            $('#bco-stop').on('click',function(){ stopped=true; log('Stopping after current batch…'); });

            function nextBatch(){
                if(stopped){finish();return;}
                let bs = parseInt($('#bco_batch_size').val())||25;
                $.post(bco.ajax_url,{action:'bco_process_batch',nonce:bco.nonce,batch_size:bs},function(r){
                    if(!r.success){log('Error: '+r.data);finish();return;}
                    processed += r.data.processed;
                    let pct = total ? Math.round(processed/total*100) : 100;
                    $('#bco-bar').val(pct);
                    $('#bco-status').text(processed+' / '+total+' ('+pct+'%)');
                    log('Batch done — '+r.data.processed+' orders completed.');
                    if(r.data.remaining > 0 && !stopped){ nextBatch(); }
                    else{ log('✅ All done! '+processed+' orders completed.'); finish(); }
                }).fail(function(x){ log('Server error ('+x.status+'). Try a smaller batch size.'); finish(); });
            }

            function finish(){ running=false; $('#bco-start').show(); $('#bco-stop').hide(); }
            function log(m){ $('#bco-log').append('<div>['+new Date().toLocaleTimeString()+'] '+m+'</div>').scrollTop(9999); }

            /* ── Fix Dates ── */
            let fRunning=false, fStopped=false, fProcessed=0, fTotal=0;

            $('#bco-fix-start').on('click',function(){
                if(fRunning) return;
                fRunning=true; fStopped=false; fProcessed=0;
                $(this).hide(); $('#bco-fix-stop').show();
                $('#bco-fix-progress,#bco-fix-log').show();
                $('#bco-fix-log').html('');
                fLog('Counting orders to fix…');

                $.post(bco.ajax_url,{action:'bco_fix_dates_count',nonce:bco.nonce,fix_date:$('#bco_fix_date').val()},function(r){
                    if(!r.success){fLog('Error: '+r.data);fFinish();return;}
                    fTotal=r.data.count;
                    fLog('Found '+fTotal+' orders to fix.');
                    if(fTotal===0){fFinish();return;}
                    fNextBatch();
                });
            });

            $('#bco-fix-stop').on('click',function(){ fStopped=true; fLog('Stopping…'); });

            function fNextBatch(){
                if(fStopped){fFinish();return;}
                let bs=parseInt($('#bco_fix_batch').val())||25;
                $.post(bco.ajax_url,{action:'bco_fix_dates_batch',nonce:bco.nonce,batch_size:bs,fix_date:$('#bco_fix_date').val()},function(r){
                    if(!r.success){fLog('Error: '+r.data);fFinish();return;}
                    fProcessed+=r.data.fixed;
                    let pct=fTotal?Math.round(fProcessed/fTotal*100):100;
                    $('#bco-fix-bar').val(pct);
                    $('#bco-fix-status').text(fProcessed+' / '+fTotal+' ('+pct+'%)');
                    fLog('Batch done — '+r.data.fixed+' dates fixed.');
                    if(r.data.remaining>0 && !fStopped){ fNextBatch(); }
                    else{ fLog('✅ All done! '+fProcessed+' order dates restored.'); fFinish(); }
                }).fail(function(x){ fLog('Server error ('+x.status+'). Try a smaller batch.'); fFinish(); });
            }

            function fFinish(){ fRunning=false; $('#bco-fix-start').show(); $('#bco-fix-stop').hide(); }
            function fLog(m){ $('#bco-fix-log').append('<div>['+new Date().toLocaleTimeString()+'] '+m+'</div>').scrollTop(9999); }
        })(jQuery);
        <?php
        return ob_get_clean();
    }

    /* ───────────────────────────────
     *  AJAX — COUNT PROCESSING ORDERS
     * ─────────────────────────────── */
    public function ajax_count_orders() {
        $this->verify();
        $orders = wc_get_orders( [
            'status' => 'processing',
            'limit'  => -1,
            'return' => 'ids',
        ] );
        wp_send_json_success( [ 'count' => count( $orders ) ] );
    }

    /* ───────────────────────────────
     *  AJAX — PROCESS A BATCH (with date preservation)
     * ─────────────────────────────── */
    public function ajax_process_batch() {
        $this->verify();
        $batch_size = absint( $_POST['batch_size'] ?? 25 );
        $batch_size = min( max( $batch_size, 1 ), 200 );

        $order_ids = wc_get_orders( [
            'status' => 'processing',
            'limit'  => $batch_size,
            'return' => 'ids',
        ] );

        $done = 0;
        foreach ( $order_ids as $order_id ) {
            $order = wc_get_order( $order_id );
            if ( ! $order ) continue;

            // Determine the correct completed date (date_paid → date_created)
            $original_date = $order->get_date_paid() ?? $order->get_date_created();

            // Remove the default "set date_completed to now()" behaviour
            remove_all_actions( 'woocommerce_order_status_completed' );

            $order->set_status( 'completed' );

            // Override date_completed with the original date
            if ( $original_date ) {
                $order->set_date_completed( $original_date->getTimestamp() );
            }

            $order->save();
            $done++;
        }

        // Count remaining
        $remaining = wc_get_orders( [
            'status' => 'processing',
            'limit'  => 1,
            'return' => 'ids',
        ] );

        wp_send_json_success( [
            'processed' => $done,
            'remaining' => count( $remaining ),
        ] );
    }

    /* ───────────────────────────────
     *  AJAX — COUNT ORDERS TO FIX
     * ─────────────────────────────── */
    public function ajax_fix_dates_count() {
        $this->verify();
        $ids = $this->get_wrongly_dated_order_ids( $_POST['fix_date'] ?? '', -1 );
        wp_send_json_success( [ 'count' => count( $ids ) ] );
    }

    /* ───────────────────────────────
     *  AJAX — FIX DATES BATCH
     * ─────────────────────────────── */
    public function ajax_fix_dates_batch() {
        $this->verify();
        $batch_size = min( max( absint( $_POST['batch_size'] ?? 25 ), 1 ), 200 );
        $fix_date   = sanitize_text_field( $_POST['fix_date'] ?? '' );

        $order_ids = $this->get_wrongly_dated_order_ids( $fix_date, $batch_size );

        $fixed = 0;
        foreach ( $order_ids as $order_id ) {
            $order = wc_get_order( $order_id );
            if ( ! $order ) continue;

            $original_date = $order->get_date_paid() ?? $order->get_date_created();
            if ( $original_date ) {
                $order->set_date_completed( $original_date->getTimestamp() );
                $order->save();
                $fixed++;
            }
        }

        $remaining = $this->get_wrongly_dated_order_ids( $fix_date, 1 );

        wp_send_json_success( [
            'fixed'     => $fixed,
            'remaining' => count( $remaining ),
        ] );
    }

    /* ───────────────────────────────
     *  HELPERS
     * ─────────────────────────────── */

    /**
     * Get completed order IDs whose date_completed falls on a specific date.
     */
    private function get_wrongly_dated_order_ids( $date_string, $limit = -1 ) {
        $date_string = sanitize_text_field( $date_string );
        if ( ! $date_string ) {
            $date_string = date( 'Y-m-d' );
        }

        $start = $date_string . 'T00:00:00';
        $end   = $date_string . 'T23:59:59';

        return wc_get_orders( [
            'status'         => 'completed',
            'limit'          => $limit,
            'return'         => 'ids',
            'date_completed' => $start . '...' . $end,
        ] );
    }

    private function verify() {
        check_ajax_referer( 'bco_nonce', 'nonce' );
        if ( ! current_user_can( 'manage_woocommerce' ) ) {
            wp_send_json_error( 'Unauthorized' );
        }
    }
}

new Bulk_Complete_Processing_Orders();
